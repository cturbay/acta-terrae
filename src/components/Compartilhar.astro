---
import { siWhatsapp, siTelegram, siReddit, siFacebook, siX, siBluesky } from 'simple-icons';
const { titulo } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://actaterrae.com.br').href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(titulo + ' — Acta Terrae');
const redes = [
  { nome: 'WhatsApp', icone: siWhatsapp.path, href: `https://wa.me/?text=${t}%20${u}` },
  { nome: 'Telegram', icone: siTelegram.path, href: `https://t.me/share/url?url=${u}&text=${t}` },
  { nome: 'Reddit', icone: siReddit.path, href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { nome: 'Facebook', icone: siFacebook.path, href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
  { nome: 'X', icone: siX.path, href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
  { nome: 'LinkedIn', icone: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { nome: 'Bluesky', icone: siBluesky.path, href: `https://bsky.app/intent/compose?text=${t}%20${u}` },
  { nome: 'E-mail', icone: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13zm2 .9v.2l8 5.4 8-5.4v-.2l-.3-.4H4.3L4 6.4zm16 2.6-7.4 5a1 1 0 0 1-1.2 0L4 9v9h16V9z', href: `mailto:?subject=${t}&body=${u}` },
];
---
<div class="compartilhar" data-url={url} data-titulo={titulo}>
  <span class="rotulo">Compartilhe</span>
  <ul>
    {redes.map((r) => (
      <li>
        <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={`Compartilhar no ${r.nome}`} title={r.nome}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={r.icone} /></svg>
        </a>
      </li>
    ))}
    <li>
      <button type="button" class="copiar" aria-label="Copiar link" title="Copiar link">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a3 3 0 0 1 4.2 4.2l-2.1 2.1a1 1 0 1 1-1.4-1.4l2.1-2.1a1 1 0 0 0-1.4-1.4L12 13.4a1 1 0 0 1-1.4 0zm2.8-2.8a1 1 0 0 1 0 1.4L9.9 15.5a3 3 0 0 1-4.2-4.2l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a1 1 0 0 0 1.4 1.4L12 10.6a1 1 0 0 1 1.4 0z" /></svg>
      </button>
    </li>
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.compartilhar').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.copiar');
    btn?.addEventListener('click', async () => {
      const url = box.dataset.url ?? location.href;
      try { await navigator.clipboard.writeText(url); btn.title = 'Link copiado!'; btn.classList.add('ok'); }
      catch { window.prompt('Copie o link:', url); }
      setTimeout(() => { btn.title = 'Copiar link'; btn.classList.remove('ok'); }, 2000);
    });
  });
</script>

<style>
  .compartilhar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; font-family: var(--sans); }
  .rotulo { font: 700 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--suave); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  a, button { display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; padding: 0; border: 1px solid var(--linha); border-radius: 50%; background: transparent; color: var(--tinta); cursor: pointer; }
  svg { width: 1.15rem; height: 1.15rem; fill: currentColor; }
  button.ok { background: var(--destaque); border-color: var(--destaque); color: #fff; }
  a:hover, button:hover { background: var(--painel); border-color: var(--destaque); color: var(--destaque); }
</style>
