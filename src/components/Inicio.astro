---
import Base from '../layouts/Base.astro';
import { reportagens } from '../data/reportagens.js';
import { ui, traduz } from '../i18n.js';
const { lang = 'pt' } = Astro.props;
const T = ui[lang];
const pre = lang === 'en' ? '/en' : '';
const [destaque] = reportagens.map((r) => traduz(r, lang));
---
<Base terra={true} lang={lang}>
  <div class="capa">
    {destaque ? (
      <article class="destaque">
        <a href={`${pre}/reportagens/${destaque.slug}/`}>
          {destaque.imagem && <img src={destaque.imagem} alt="" />}
          <p class="secao">{destaque.secao}</p>
          <h1>{destaque.titulo}</h1>
          <p class="resumo">{destaque.resumo}</p>
          <p class="autor">{T.por} {destaque.autor}{destaque.data && ` · ${destaque.data}`}</p>
        </a>
      </article>
    ) : (
      <p class="vazio">{T.vazio}</p>
    )}

  </div>
</Base>

<style is:global>
  main:has(.capa) { padding: 0; min-height: 0; }
  main:has(.capa)::after { display: none; }
</style>

<style>
  .capa { margin: 0; }
  .destaque a { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: max(30rem, calc(100svh - var(--faixa))); padding: clamp(1.4rem, 4vw, 3.5rem); color: #fbf6ea; text-decoration: none; overflow: hidden; background: #2a241b; }
  .destaque a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,12,8,.88) 0%, rgba(15,12,8,.62) 38%, rgba(15,12,8,.12) 75%, rgba(15,12,8,0) 100%); pointer-events: none; }
  .destaque img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .destaque a:hover img { transform: scale(1.03); }
  .destaque a > :not(img) { position: relative; z-index: 2; max-width: 44rem; }
  .secao { font: 700 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: #f0b48a; margin: 0 0 .5rem; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3.2rem); line-height: 1.08; margin: 0 0 .8rem; font-weight: 700; letter-spacing: -.01em; color: #fbf6ea; }
  .destaque a:hover h1 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .resumo { font-size: 1.1rem; color: #e9e0cc; margin: 0 0 .8rem; }
  .autor { font: .8rem var(--sans); color: #cfc6b0; margin: 0; }
  .vazio { color: var(--suave); font-style: italic; }
</style>
