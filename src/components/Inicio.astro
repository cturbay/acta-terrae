---
import Base from '../layouts/Base.astro';
import { reportagens } from '../data/reportagens.js';
import { ui, traduz } from '../i18n.js';
const { lang = 'pt' } = Astro.props;
const T = ui[lang];
const pre = lang === 'en' ? '/en' : '';
const [destaque] = reportagens.map((r) => traduz(r, lang));
---
<Base terra={true} lang={lang}>
  <div class="capa">
    {destaque ? (
      <article class="destaque">
        <a href={`${pre}/reportagens/${destaque.slug}/`}>
          {destaque.imagem && <img src={destaque.imagem} alt="" />}
          <p class="secao">{destaque.secao}</p>
          <h1>{destaque.titulo}</h1>
          <p class="resumo">{destaque.resumo}</p>
          <p class="autor">{T.por} {destaque.autor}{destaque.data && ` · ${destaque.data}`}</p>
        </a>
      </article>
    ) : (
      <p class="vazio">{T.vazio}</p>
    )}

  </div>
</Base>

<style>
  .capa { max-width: 68rem; margin-inline: auto; }
  .destaque a { display: grid; grid-template-columns: minmax(0,1.5fr) minmax(0,1fr); column-gap: 2.5rem; align-content: start; }
  .destaque a img { grid-row: 1 / span 6; }
  .destaque a > :not(img) { grid-column: 2; }
  
  .destaque a { text-decoration: none; }
  .destaque img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; background: var(--linha); }
  .secao { font: 700 .72rem var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--destaque); margin: 1rem 0 .3rem; }
  h1 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); line-height: 1.08; margin: 0 0 .8rem; font-weight: 700; letter-spacing: -.01em; }
  .destaque a:hover h1 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  @media (max-width: 60rem) { .destaque a { display: block; } }
  .resumo { font-size: 1.15rem; color: var(--suave); margin: 0 0 .8rem; max-width: 40rem; }
  .autor { font: .8rem var(--sans); color: var(--suave); margin: 0; }
  .vazio { color: var(--suave); font-style: italic; }
</style>
