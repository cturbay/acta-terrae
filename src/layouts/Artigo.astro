---
import Base from './Base.astro';
import Compartilhar from '../components/Compartilhar.astro';
// true = mostra a seção de comentários (o formulário ainda está desativado)
const comentariosAbertos = true;
const { titulo, secao, linhas = [], descricao, data } = Astro.props;
---
<Base title={titulo} description={descricao} carrossel={false}>
  <article class="artigo">
    <header class="cabeca">
      <p class="kicker">{secao}</p>
      <h1>{titulo}</h1>
      <div class="creditos">
        {linhas.map((l) => <p>{l}</p>)}
        {data && <p>{data}</p>}
      </div>
      <div class="topo-compart"><Compartilhar titulo={titulo} /></div>
    </header>
    <div class="corpo">
      <slot />
    </div>
    <div class="fim-compart"><Compartilhar titulo={titulo} /></div>
    {comentariosAbertos && (
    <section class="comentarios" id="comentarios" aria-labelledby="tit-coment" data-pagina={Astro.url.pathname}>
      <h2 id="tit-coment">Comentários</h2>
      <div class="lista-coment" aria-live="polite"></div>
      <p class="aviso">Seu comentário será lido e aprovado antes de aparecer aqui.</p>
      <form class="form-coment">
        <label>Nome <input type="text" name="nome" maxlength="80" required autocomplete="name" /></label>
        <label>Comentário <textarea name="texto" rows="4" maxlength="2000" required></textarea></label>
        <label class="isca" aria-hidden="true">Não preencha <input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
        <button type="submit">Enviar para aprovação</button>
        <p class="retorno" role="status"></p>
      </form>
    </section>
    )}
  </article>
</Base>

<script>
  const sec = document.querySelector<HTMLElement>('.comentarios');
  if (sec) {
    const pagina = sec.dataset.pagina ?? '';
    const lista = sec.querySelector<HTMLElement>('.lista-coment')!;
    const form = sec.querySelector<HTMLFormElement>('.form-coment')!;
    const retorno = sec.querySelector<HTMLElement>('.retorno')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    fetch('/api/comentarios?pagina=' + encodeURIComponent(pagina))
      .then((r) => (r.ok ? r.json() : []))
      .then((itens: { nome: string; texto: string; criado_em: string }[]) => {
        for (const c of itens) {
          const div = document.createElement('div');
          div.className = 'coment';
          const q = document.createElement('p');
          q.className = 'quem';
          q.textContent = c.nome + ' ';
          const d = document.createElement('span');
          d.textContent = '· ' + new Date(c.criado_em.replace(' ', 'T') + 'Z').toLocaleDateString('pt-BR');
          q.append(d);
          const t = document.createElement('p');
          t.textContent = c.texto;
          div.append(q, t);
          lista.append(div);
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const dados = Object.fromEntries(new FormData(form)) as Record<string, string>;
      botao.disabled = true;
      retorno.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/comentarios', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...dados, pagina }),
        });
        const res = await r.json().catch(() => ({}));
        if (r.ok) {
          form.reset();
          retorno.textContent = 'Obrigado! Seu comentário foi enviado e aparecerá aqui depois de aprovado.';
        } else {
          retorno.textContent = res.erro || 'Não foi possível enviar agora. Tente de novo mais tarde.';
        }
      } catch {
        retorno.textContent = 'Não foi possível enviar agora. Tente de novo mais tarde.';
      }
      botao.disabled = false;
    });
  }
</script>

<style is:global>
  .artigo { padding-top: .5rem; }
  .topo-compart { display: flex; justify-content: center; margin-top: 1.1rem; }
  .fim-compart { max-width: 60rem; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--linha); }
  .fim-compart + .comentarios { margin-top: 1.5rem; }
  .comentarios { max-width: 60rem; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--linha); }
  .comentarios h2 { margin: 0 0 .5rem; font: 700 .8rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .comentarios .aviso { font: .92rem var(--sans); color: var(--suave); margin: 0 0 1rem; }
  .form-coment { display: grid; gap: .9rem; max-width: 36rem; }
  .isca { position: absolute; left: -9999px; }
  .retorno { margin: 0; font: .9rem var(--sans); color: var(--suave); }
  .lista-coment { display: grid; gap: 1rem; margin: 0 0 1.5rem; }
  .coment { padding: .9rem 1.1rem; background: var(--painel); border-left: 3px solid var(--destaque); }
  .coment .quem { margin: 0 0 .3rem; font: 700 .85rem var(--sans); }
  .coment .quem span { font-weight: 400; color: var(--suave); }
  .coment p { margin: 0; white-space: pre-wrap; }
  .form-coment label { display: grid; gap: .3rem; font: 600 .85rem var(--sans); }
  .form-coment input, .form-coment textarea { font: 1rem var(--serif); padding: .55rem .7rem; border: 1px solid var(--linha); background: #fffaf0; border-radius: 3px; }
  .form-coment button { justify-self: start; font: 700 .85rem var(--sans); padding: .6rem 1.1rem; background: var(--destaque); color: #fff; border: 0; border-radius: 3px; }
  .cabeca { max-width: 66rem; margin: 0 auto 2rem; text-align: center; }
  .kicker { font: 700 .75rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--destaque); margin: 0 0 .6rem; }
  .cabeca h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; margin: 0 0 1rem; letter-spacing: -.01em; }
  .creditos p { margin: 0; font: .85rem var(--sans); color: var(--suave); }
  .corpo { max-width: 60rem; margin: 0 auto; font-size: 1.22rem; line-height: 1.72; }
  .corpo p { margin: 0 0 1.25rem; hyphens: auto; }
  .corpo > p:first-of-type::first-letter {
    float: left; font-size: 4.2rem; line-height: .8; padding: .35rem .5rem 0 0; font-weight: 700;
  }
  .corpo a { color: var(--destaque); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .corpo hr { border: 0; text-align: center; margin: 2.2rem 0; }
  .corpo hr::before { content: '· · ·'; letter-spacing: .6em; color: var(--suave); }
  .corpo figure { margin: 2rem 0; }
  .corpo figure img { display: block; width: 100%; }
  .corpo figcaption { font: .85rem/1.5 var(--sans); color: var(--suave); margin-top: .6rem; }
  .corpo figure.alta img { max-width: 28rem; margin-inline: auto; }
  .corpo figure.mapa img { max-width: min(100%, 43rem); }
  .corpo figure.larga { margin-inline: -6rem; }
  .corpo .entrevista { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 1.5rem; align-items: center; margin: 2.2rem -6rem; }
  .corpo .entrevista img { display: block; width: 100%; }
  .corpo .entrevista blockquote { margin: 0; padding-left: 1.1rem; border-left: 3px solid var(--destaque); font-size: 1.2rem; line-height: 1.5; }
  .corpo .entrevista blockquote p { margin: 0 0 .8rem; font-style: italic; }
  .corpo .entrevista.inverte img { order: 2; }
  .corpo .entrevista.inverte blockquote { order: 1; }
  .corpo .legenda-nome { font: 600 .82rem var(--sans); letter-spacing: .04em; color: var(--suave); text-align: left; }
  .corpo .licenca { display: flex; align-items: center; gap: .8rem; font: .82rem/1.5 var(--sans); color: var(--suave); }
  .corpo .licenca img { width: 66px; height: auto; flex: none; }
  .corpo .bio { font-size: 1rem; }
  .corpo .refs { font-size: .9rem; line-height: 1.55; }
  .corpo .refs p { margin-bottom: .6rem; }
  @media (max-width: 78rem) {
    .corpo figure.larga, .corpo .entrevista { margin-inline: 0; }
  }
  @media (max-width: 40rem) {
    .corpo .entrevista { grid-template-columns: 1fr; }
    .corpo .entrevista.inverte img, .corpo .entrevista.inverte blockquote { order: initial; }
  }
</style>
