---
import Base from './Base.astro';
import Compartilhar from '../components/Compartilhar.astro';
// true = mostra a seção de comentários (o formulário ainda está desativado)
const comentariosAbertos = true;
import { ui } from '../i18n.js';
const { titulo, secao, linhas = [], descricao, data, capa, capaAlt = '', capaLegenda, claro = false, lang = 'pt' } = Astro.props;
const T = ui[lang];
const slugOg = capa.split('/')[2];
// os comentários são compartilhados entre os idiomas: usam sempre o endereço em português
const paginaComent = Astro.url.pathname.replace(/^\/en(?=\/)/, '');
---
<Base title={titulo} description={descricao} imagem={`/og/${slugOg}.jpg`} carrossel={false} revista={true} lang={lang}>
  <article class="artigo">
    <header class="hero">
      {capa && <img class="hero-img" src={capa} alt={capaAlt} />}
      <div class:list={["hero-scrim", { claro }]}></div>
      <div class="hero-txt">
        <p class="kicker">{secao}</p>
        <h1>{titulo}</h1>
        <div class="creditos">
          {linhas.map((l) => <p>{l}</p>)}
          {data && <p>{data}</p>}
        </div>
      </div>
    </header>
    {capaLegenda && <p class="hero-legenda">{capaLegenda}</p>}
    <div class="topo-compart"><Compartilhar titulo={titulo} lang={lang} /></div>
    <div class="corpo">
      <slot />
    </div>
    <div class="fim-compart"><Compartilhar titulo={titulo} lang={lang} /></div>
    {comentariosAbertos && (
    <section class="comentarios" id="comentarios" aria-labelledby="tit-coment" data-pagina={paginaComent} data-enviando={T.enviando} data-obrigado={T.obrigado} data-erro={T.erroEnvio}>
      <h2 id="tit-coment">{T.comentarios}</h2>
      <div class="lista-coment" aria-live="polite"></div>
      <p class="aviso">{T.avisoComent}</p>
      <form class="form-coment">
        <label>{T.nome} <input type="text" name="nome" maxlength="80" required autocomplete="name" /></label>
        <label>{T.comentario} <textarea name="texto" rows="4" maxlength="2000" required></textarea></label>
        <label class="isca" aria-hidden="true">{T.naoPreencha} <input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
        <button type="submit">{T.enviar}</button>
        <p class="retorno" role="status"></p>
      </form>
    </section>
    )}
  </article>
</Base>

<script>
  const sec = document.querySelector<HTMLElement>('.comentarios');
  if (sec) {
    const pagina = sec.dataset.pagina ?? '';
    const lista = sec.querySelector<HTMLElement>('.lista-coment')!;
    const form = sec.querySelector<HTMLFormElement>('.form-coment')!;
    const retorno = sec.querySelector<HTMLElement>('.retorno')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    fetch('/api/comentarios?pagina=' + encodeURIComponent(pagina))
      .then((r) => (r.ok ? r.json() : []))
      .then((itens: { nome: string; texto: string; criado_em: string }[]) => {
        for (const c of itens) {
          const div = document.createElement('div');
          div.className = 'coment';
          const q = document.createElement('p');
          q.className = 'quem';
          q.textContent = c.nome + ' ';
          const d = document.createElement('span');
          d.textContent = '· ' + new Date(c.criado_em.replace(' ', 'T') + 'Z').toLocaleDateString(document.documentElement.lang || 'pt-BR');
          q.append(d);
          const t = document.createElement('p');
          t.textContent = c.texto;
          div.append(q, t);
          lista.append(div);
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const dados = Object.fromEntries(new FormData(form)) as Record<string, string>;
      botao.disabled = true;
      retorno.textContent = sec.dataset.enviando ?? '';
      try {
        const r = await fetch('/api/comentarios', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...dados, pagina }),
        });
        const res = await r.json().catch(() => ({}));
        if (r.ok) {
          form.reset();
          retorno.textContent = sec.dataset.obrigado ?? '';
        } else {
          retorno.textContent = res.erro || sec.dataset.erro || '';
        }
      } catch {
        retorno.textContent = sec.dataset.erro ?? '';
      }
      botao.disabled = false;
    });
  }
</script>

<style is:global>
  .artigo { padding-top: 0; }
  .topo-compart { display: flex; justify-content: center; margin: 2rem 0 1rem; padding: 0 1.25rem; }
  .fim-compart { max-width: 64rem; margin: 3rem auto 0; padding: 1.5rem 1.25rem 0; border-top: 1px solid var(--linha); }
  .fim-compart + .comentarios { margin-top: 1.5rem; }
  .comentarios { max-width: 64rem; margin: 3rem auto 0; padding: 1.5rem 1.25rem 0; border-top: 1px solid var(--linha); }
  .comentarios h2 { margin: 0 0 .5rem; font: 700 .8rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .comentarios .aviso { font: .92rem var(--sans); color: var(--suave); margin: 0 0 1rem; }
  .form-coment { display: grid; gap: .9rem; max-width: 36rem; }
  .isca { position: absolute; left: -9999px; }
  .retorno { margin: 0; font: .9rem var(--sans); color: var(--suave); }
  .lista-coment { display: grid; gap: 1rem; margin: 0 0 1.5rem; }
  .coment { padding: .9rem 1.1rem; background: var(--painel); border-left: 3px solid var(--destaque); }
  .coment .quem { margin: 0 0 .3rem; font: 700 .85rem var(--sans); }
  .coment .quem span { font-weight: 400; color: var(--suave); }
  .coment p { margin: 0; white-space: pre-wrap; }
  .form-coment label { display: grid; gap: .3rem; font: 600 .85rem var(--sans); }
  .form-coment input, .form-coment textarea { font: 1rem var(--serif); padding: .55rem .7rem; border: 1px solid var(--linha); background: #fffaf0; border-radius: 3px; }
  .form-coment button { justify-self: start; font: 700 .85rem var(--sans); padding: .6rem 1.1rem; background: var(--destaque); color: #fff; border: 0; border-radius: 3px; }

  /* ---------- Abertura ---------- */
  .hero { position: relative; height: min(88vh, 760px); min-height: 460px; background: #1d1a14; overflow: hidden; display: flex; align-items: flex-end; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,12,8,.10) 0%, rgba(15,12,8,.35) 45%, rgba(15,12,8,.88) 100%); }
  .hero-scrim.claro { background: linear-gradient(180deg, rgba(15,12,8,0) 0%, rgba(15,12,8,0) 40%, rgba(15,12,8,.5) 66%, rgba(15,12,8,.84) 100%); }
  .hero-txt { position: relative; width: 100%; max-width: 66rem; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 3rem) clamp(2rem, 6vw, 4rem); text-align: left; }
  .hero .kicker { font: 700 .8rem var(--sans); letter-spacing: .22em; text-transform: uppercase; color: #f0b48a; margin: 0 0 1rem; }
  .hero h1 { font-family: var(--titulo); font-weight: 900; font-size: clamp(2.2rem, 6.2vw, 4.75rem); line-height: 1.04; letter-spacing: -.01em; color: #fbf6ea; margin: 0; text-shadow: 0 2px 16px rgba(0,0,0,.55); }
  .hero .creditos { margin-top: 1.4rem; }
  .hero .creditos p { font: .88rem var(--sans); letter-spacing: .04em; color: #e6dcc7; margin: 0 0 .2rem; }
  .hero-legenda { max-width: 66rem; margin: .8rem auto 0; padding: 0 clamp(1.25rem, 4vw, 3rem); font: 1rem/1.55 var(--sans); color: var(--suave); }

  /* ---------- Texto ---------- */
  body.revista { overflow-x: clip; }
  .corpo { max-width: 64rem; margin: 0 auto; padding: 1.5rem 1.25rem 0; font-size: 1.22rem; line-height: 1.72; }
  .corpo p { margin: 0 0 1.6rem; hyphens: auto; }
  .corpo > p:first-of-type::first-letter { float: left; font-family: var(--titulo); font-weight: 900; font-size: 6.2rem; line-height: .82; padding: .55rem .8rem 0 0; color: var(--destaque); }
  .corpo a { color: var(--destaque); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .corpo hr { border: 0; text-align: center; margin: 2.4rem 0; }
  .corpo hr::before { content: '· · ·'; letter-spacing: .6em; color: var(--suave); }
  .corpo figure { margin: 2.4rem 0; }
  .corpo figure img { display: block; width: 100%; }
  .corpo figcaption { font: 1rem/1.55 var(--sans); color: var(--suave); margin-top: .8rem; text-align: justify; hyphens: auto; }
  .corpo figure.alta img { max-width: 28rem; margin-inline: auto; }
  .corpo figure.alta.mapa img { max-width: min(100%, 43rem); }
  .corpo figure.mapa { max-width: 100%; margin-inline: auto; }
  .corpo figure.mapa.estreita { max-width: min(100%, 46rem); }
  .corpo figure.media { max-width: 100%; margin-inline: auto; }
  .corpo figure.par { max-width: 100%; margin-inline: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  .corpo figure.par > div { margin: 0; }
  .corpo figure.par img { aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 40rem) { .corpo figure.par { grid-template-columns: 1fr; gap: 1.6rem; } }
  .corpo figure.larga { width: min(100vw, 66rem); margin-inline: calc(50% - min(50vw, 33rem)); padding-inline: 1.25rem; }
  .corpo figure.larga img { width: 100%; }

  /* Dado em destaque */
  .corpo .faixa-dado { width: 100vw; margin: 2.6rem calc(50% - 50vw); background: #1f2a21; color: #f1ead9; padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4rem); display: flex; flex-wrap: wrap; gap: 2.5rem 4rem; align-items: center; justify-content: center; }
  .corpo .faixa-dado .dado { display: flex; flex-direction: column; }
  .corpo .faixa-dado .num { font-family: var(--titulo); font-weight: 900; font-size: clamp(5rem, 14vw, 10.5rem); line-height: .95; color: #f0b48a; }
  .corpo .faixa-dado .rot { font: 700 .8rem var(--sans); letter-spacing: .22em; text-transform: uppercase; color: #cfc6b0; margin-top: .5rem; }
  .corpo .faixa-dado p { flex: 1 1 22rem; max-width: 34rem; margin: 0; font-size: 1.55rem; line-height: 1.5; hyphens: none; }

  /* Foto em tela cheia com frase */
  .corpo figure.foto-cheia { position: relative; width: 100vw; margin: 2.6rem calc(50% - 50vw) 0; padding-bottom: 0; }
  .corpo figure.foto-cheia img { width: 100%; height: clamp(420px, 70vh, 640px); object-fit: cover; }
  .corpo figure.foto-cheia::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: clamp(420px, 70vh, 640px); background: radial-gradient(ellipse 62% 36% at 50% 27%, rgba(15,12,8,.5) 0%, rgba(15,12,8,.28) 60%, rgba(15,12,8,0) 100%), rgba(15,12,8,.26); pointer-events: none; }
  .corpo figure.foto-cheia .frase { position: absolute; left: 0; right: 0; top: 0; height: clamp(420px, 70vh, 640px); z-index: 2; display: flex; align-items: flex-start; justify-content: center; padding: 15% clamp(1.25rem, 5vw, 4rem) 0; }
  .corpo figure.foto-cheia .frase p { margin: 0; max-width: 56rem; text-align: center; font-family: var(--titulo); font-weight: 700; font-size: clamp(1.7rem, 4vw, 2.9rem); line-height: 1.22; color: #fbf6ea; hyphens: none; text-shadow: 0 2px 14px rgba(0,0,0,.65), 0 0 3px rgba(0,0,0,.5); }
  @media (min-width: 56rem) {
    .corpo figure.foto-cheia .frase { padding: 13% 5vw 0 52%; }
    .corpo figure.foto-cheia::after { background: radial-gradient(ellipse 36% 36% at 74% 27%, rgba(15,12,8,.5) 0%, rgba(15,12,8,.28) 60%, rgba(15,12,8,0) 100%), rgba(15,12,8,.22); }
    .corpo figure.foto-cheia .frase p { font-size: clamp(1.7rem, 3vw, 2.6rem); }
  }
  .corpo figure.foto-cheia.sem-legenda { margin-bottom: 2.6rem; }
  .corpo figure.foto-cheia figcaption { max-width: 64rem; margin: .8rem auto 2.6rem; padding: 0 1.25rem; }

  /* Entrevistas em faixas de cor */
  .corpo .entrevista { width: 100vw; margin: 2.6rem calc(50% - 50vw); display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; background: var(--fundo); color: var(--cor); }
  .corpo .entrevista img { grid-column: 1; grid-row: 1; width: 100%; height: 100%; min-height: 420px; max-height: 760px; object-fit: cover; }
  .corpo .entrevista blockquote { grid-column: 2; grid-row: 1; margin: 0; padding: clamp(2.2rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem); display: flex; flex-direction: column; justify-content: center; border: 0; font-family: var(--titulo); font-style: italic; font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.4; }
  .corpo .entrevista blockquote::before { content: 'Vozes da região'; font: 700 .72rem var(--sans); font-style: normal; letter-spacing: .22em; text-transform: uppercase; color: var(--rotulo); margin-bottom: 1.4rem; }
  .corpo .entrevista blockquote p { margin: 0 0 1rem; font-style: italic; hyphens: none; }
  .corpo .entrevista .legenda-nome { font: 600 .9rem var(--sans); font-style: normal; letter-spacing: .02em; color: var(--sub); margin-top: .8rem; }
  .corpo .entrevista.wil img, .corpo .entrevista.vinicius img { grid-column: 2; }
  .corpo .entrevista.wil blockquote, .corpo .entrevista.vinicius blockquote { grid-column: 1; }
  .corpo .entrevista.ipe { --fundo: #b4532a; --cor: #fbf1e4; --sub: #ffe7d3; --rotulo: #ffd9bd; }
  .corpo .entrevista.wil { --fundo: #e6d9bf; --cor: #1d1a14; --sub: #3a3226; --rotulo: #6e4a2c; }
  .corpo .entrevista.fernando { --fundo: #1f2a21; --cor: #f1ead9; --sub: #c9d1c3; --rotulo: #f0b48a; }
  .corpo .entrevista.vinicius { --fundo: #2b2620; --cor: #f6f1e7; --sub: #d9ceb8; --rotulo: #f0b48a; }

  .corpo .videos { margin: 2rem 0 1rem; }
  .corpo .videos h2 { margin: 0 0 1.2rem; font: 700 .8rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--destaque); }
  .corpo .videos figure.video { margin: 0 0 2rem; }
  .corpo .videos .player { position: relative; aspect-ratio: 16 / 9; background: #1d1a14; }
  .corpo .videos iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .corpo .licenca { display: flex; align-items: center; gap: .8rem; font: .82rem/1.5 var(--sans); color: var(--suave); }
  .corpo .licenca img { width: 66px; height: auto; flex: none; }
  .corpo .ouca { display: block; margin: 2.6rem 0 0; padding: 1.2rem 1.4rem; background: var(--painel, #ece3d1); border-left: 4px solid var(--destaque); text-decoration: none; color: var(--tinta); }
  .corpo .ouca span { display: block; }
  .corpo .ouca-rotulo { font: 700 .75rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--destaque); margin-bottom: .35rem; }
  .corpo .ouca-tit { font: 700 1.25rem/1.3 var(--titulo, Georgia, serif); }
  .corpo .ouca-sub { font: .88rem var(--sans); color: var(--suave); margin-top: .3rem; }
  .corpo .ouca:hover .ouca-tit { color: var(--destaque); text-decoration: underline; text-underline-offset: 3px; }
  .corpo .bio { margin: 2.6rem 0; padding: 1.4rem 0 .2rem; border-top: 3px solid var(--tinta); }
  .corpo .bio::before { content: attr(data-rotulo); display: block; margin-bottom: .6rem; font: 700 .75rem var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--destaque); }
  .corpo .bio p { margin: 0; font: italic 1.15rem/1.65 var(--titulo, Georgia, serif); color: #3a3328; max-width: 46rem; }
  .corpo .bio strong { font-weight: 400; }
  .corpo .refs { font: .9rem/1.6 var(--sans); color: #4a4235; }
  .corpo .refs p { margin-bottom: .7rem; }
  @media (max-width: 48rem) {
    .corpo .entrevista { grid-template-columns: 1fr; }
    .corpo .entrevista img, .corpo .entrevista.wil img, .corpo .entrevista.vinicius img { grid-column: 1; grid-row: 1; min-height: 300px; max-height: 420px; }
    .corpo .entrevista blockquote, .corpo .entrevista.wil blockquote, .corpo .entrevista.vinicius blockquote { grid-column: 1; grid-row: 2; }
    .corpo figure.larga { margin-inline: calc(50% - 50vw); width: 100vw; padding-inline: 0; }
    .corpo figure.larga figcaption { padding-inline: 1.25rem; }
  }
</style>
